{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Debug APK (Gradle)",
            "type": "shell",
            "command": "./gradlew assembleDebug",
            "windows": {
                "command": ".\\gradlew.bat assembleDebug"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gradle"]
        },
        {
            "label": "Run Unit Tests (Gradle)",
            "type": "shell",
            "command": "./gradlew test",
            "windows": {
                "command": ".\\gradlew.bat test"
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": ["$gradle"]
        },
        {
            "label": "Install Debug APK on Device/Emulator (Gradle)",
            "type": "shell",
            "command": "./gradlew installDebug",
            "windows": {
                "command": ".\\gradlew.bat installDebug"
            },
            "group": "build",
            "problemMatcher": ["$gradle"]
        },
        {
            "label": "Clean Project (Gradle)",
            "type": "shell",
            "command": "./gradlew clean",
            "windows": {
                "command": ".\\gradlew.bat clean"
            },
            "problemMatcher": ["$gradle"]
        }
    ]
}
