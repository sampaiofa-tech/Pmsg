rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Verifica se o cliente está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Verifica se o solicitante é participante (remetente ou destinatário)
    function isParticipant(senderId, recipientId) {
      return isAuthenticated() && (request.auth.uid == senderId || request.auth.uid == recipientId);
    }

    // =========================================================================
    // COLEÇÃO: messages
    // =========================================================================
    // Read: Restrito a participantes da conversa.
    // Create: Exige expiresAt obrigatório (tipo timestamp e superior a request.time).
    // Update: TERMINANTEMENTE NEGADO (mensagens são imutáveis após gravação).
    // Delete: Permitido apenas a participantes (vanish-after-read e deleção voluntária).
    // NOTA DE DESIGN: Não exige request.app != null para manter interoperabilidade
    // com clientes desktop (cuja proteção provém da autenticação via proxy).
    match /messages/{messageId} {
      allow read: if isParticipant(resource.data.senderId, resource.data.recipientId);

      allow create: if isParticipant(request.resource.data.senderId, request.resource.data.recipientId)
                    && request.resource.data.expiresAt is timestamp
                    && request.resource.data.expiresAt > request.time;

      allow update: if false;

      allow delete: if isParticipant(resource.data.senderId, resource.data.recipientId);
    }

    // =========================================================================
    // COLEÇÃO: messageKeys (DEK - Data Encryption Keys)
    // =========================================================================
    // ISOLAMENTO TOTAL: Leitura e escrita NEGADAS para todos os clientes SDK.
    // Somente o Firebase Admin SDK (Cloud Functions backend) possui privilégio
    // de acesso para geração e destruição programática das chaves (Crypto-Shredding).
    match /messageKeys/{messageId} {
      allow read, write: if false;
    }

    // =========================================================================
    // COLEÇÃO: userRateLimits
    // =========================================================================
    // ISOLAMENTO TOTAL: Contadores de rate limit gerenciados exclusivamente pelo
    // Admin SDK nas Cloud Functions.
    match /userRateLimits/{uid} {
      allow read, write: if false;
    }

    // =========================================================================
    // COLEÇÃO: invites (Modelo C - Convites Efêmeros Remotos)
    // =========================================================================
    // ISOLAMENTO TOTAL: Leitura e escrita NEGADAS para todos os clientes SDK.
    // Gerenciamento e incineração (vanish-after-accept) exclusivos via Cloud Functions Admin SDK.
    match /invites/{inviteId} {
      allow read, write: if false;
    }

    // =========================================================================
    // COLEÇÃO: identities (Diretório Técnico de Roteamento)
    // =========================================================================
    // Read: NEGADO para clientes SDK (resolução restrita à callable resolveFingerprint).
    // Create: Permitido apenas se autenticado, se for novo doc e request.auth.uid == currentAuthUid.
    // Update: TERMINANTEMENTE NEGADO para clientes SDK (exige updateIdentityRouting com prova de posse Ed25519).
    // Delete: NEGADO.
    match /identities/{fingerprint} {
      allow read: if false;
      allow create: if isAuthenticated()
                    && request.resource.data.currentAuthUid == request.auth.uid
                    && !exists(/databases/$(database)/documents/identities/$(fingerprint));
      allow update, delete: if false;
    }

    // =========================================================================
    // COLEÇÕES: abuseReports e abuseMetrics (Denúncias Comportamentais - v1.3)
    // =========================================================================
    // ISOLAMENTO TOTAL: Leitura e escrita NEGADAS para todos os clientes SDK.
    // Registro e métricas comportamentais exclusivos via Cloud Functions Admin SDK.
    match /abuseReports/{reportId} {
      allow read, write: if false;
    }

    match /abuseMetrics/{fingerprint} {
      allow read, write: if false;
    }

    // =========================================================================
    // COLEÇÃO: connectionLogs (Marco Civil da Internet Art. 15 - 180 dias TTL)
    // =========================================================================
    // ISOLAMENTO TOTAL: Leitura e escrita NEGADAS para todos os clientes SDK.
    // Registro estrito de IP, porta e timestamp via Cloud Functions Admin SDK.
    match /connectionLogs/{logId} {
      allow read, write: if false;
    }

    // Bloqueio preventivo padrão para qualquer outro documento não mapeado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
